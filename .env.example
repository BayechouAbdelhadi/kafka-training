# Kafka: use localhost when running apps on your host; use kafka-1:9092,... only when apps run inside Docker same network
KAFKA_BOOTSTRAP_SERVERS=localhost:9092,localhost:9094,localhost:9095,localhost:9096
# Silence KafkaJS v2 partitioner migration warning
KAFKAJS_NO_PARTITIONER_WARNING=1
# Service ports (optional; defaults shown)
# API_PORT=3000
# DETECTOR_PORT=3001
# ANALYZER_CAP_PORT=3011
# ANALYZER_LABEL_PORT=3012
# ANALYZER_SHAPE_PORT=3013
# AUTOMATION_PORT=3020
# TRACKER_PORT=3030
# Optional: Schema Registry for Avro (Step 5 exercises)
# SCHEMA_REGISTRY_URL=http://localhost:8081
